  <joint name="joint_wheel_left" type="continuous">
    <origin xyz="0.018 0.05 0.0205" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="wheel_left"/>
    <axis xyz="1 0 0"/>
  </joint>

  <!-- ==================== FRONT CASTER ==================== -->
  <link name="caster_front">
    <inertial>
      <origin xyz="0.0 0.0 -0.002631020066889628" rpy="0 0 0"/>
      <mass value="0.0003639927788265455"/>
      <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="-0.0" izz="0.0"/>
