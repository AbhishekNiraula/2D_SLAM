        <mesh filename="file:///home/abhiniraula/Documents/Electronics Engineering/Sixth Semester/Minor Project/Minor Project Code/SLAM_Bot_Prototype/esp32_bot_description/meshes/caster_rear_1.stl" scale="0.001 0.001 0.001"/>
