<?xml version="1.0"?>
<robot name="esp32_bot">

  <!-- ==================== MATERIALS ==================== -->
  <material name="silver">
    <color rgba="0.700 0.700 0.700 1.000"/>
  </material>

  <!-- ==================== BASE LINK (real odom frame, no geometry) ==================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.07000000000000302 0.05003463317028874 0.03937072162966072" rpy="0 0 0"/>
      <mass value="0.4791631698015682"/>
      <inertia ixx="0.000483" ixy="0.0" ixz="0.0" iyy="0.00048" iyz="1e-06" izz="0.000799"/>
    </inertial>
  </link>

  <!-- ==================== CHASSIS (mesh + everything, rotated -90 to match odom's forward=+X) ==================== -->
  <joint name="base_link_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
  </joint>

  <link name="chassis">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/abhiniraula/Documents/Electronics Engineering/Sixth Semester/Minor Project/Minor Project Code/SLAM_Bot_Prototype/esp32_bot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/abhiniraula/Documents/Electronics Engineering/Sixth Semester/Minor Project/Minor Project Code/SLAM_Bot_Prototype/esp32_bot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== RIGHT WHEEL ==================== -->
  <link name="wheel_right">
    <inertial>
      <origin xyz="0.00849999999999998 7.450580569168253e-10 5.960464760645934e-11" rpy="0 0 0"/>
      <mass value="0.01986743194130184"/>
      <inertia ixx="4e-06" ixy="-0.0" ixz="-0.0" iyy="2e-06" iyz="0.0" izz="2e-06"/>
    </inertial>
    <visual>
      <origin xyz="-0.122 -0.05 -0.0205" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/abhiniraula/Documents/Electronics Engineering/Sixth Semester/Minor Project/Minor Project Code/SLAM_Bot_Prototype/esp32_bot_description/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="-0.122 -0.05 -0.0205" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/abhiniraula/Documents/Electronics Engineering/Sixth Semester/Minor Project/Minor Project Code/SLAM_Bot_Prototype/esp32_bot_description/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_wheel_right" type="continuous">
    <origin xyz="0.122 0.05 0.0205" rpy="0 0 0"/>
    <parent link="chassis"/>
    <child link="wheel_right"/>
    <axis xyz="1 0 0"/>
  </joint>

  <!-- ==================== LEFT WHEEL ==================== -->
  <link name="wheel_left">
    <inertial>
      <origin xyz="-0.008499999999999997 7.450580638557192e-10 7.450581124279765e-11" rpy="0 0 0"/>
      <mass value="0.019867431941301854"/>
      <inertia ixx="4e-06" ixy="0.0" ixz="0.0" iyy="2e-06" iyz="0.0" izz="2e-06"/>
    </inertial>
    <visual>
      <origin xyz="-0.018 -0.05 -0.0205" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/abhiniraula/Documents/Electronics Engineering/Sixth Semester/Minor Project/Minor Project Code/SLAM_Bot_Prototype/esp32_bot_description/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
