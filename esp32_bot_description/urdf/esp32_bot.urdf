    <child link="caster_front"/>
  </joint>

  <!-- ==================== REAR CASTER ==================== -->
  <link name="caster_rear">
    <inertial>
      <origin xyz="-1.3877787807814457e-17 0.0 -0.0026310200668896297" rpy="0 0 0"/>
