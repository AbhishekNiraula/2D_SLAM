    </inertial>
    <visual>
      <origin xyz="0.09 0.0 0.001" rpy="0 0 1.5708"/>
      <geometry>
        <mesh filename="file:///home/abhiniraula/Documents/Electronics Engineering/Sixth Semester/Minor Project/Minor Project Code/SLAM_Bot_Prototype/esp32_bot_description/meshes/laser_1.stl" scale="0.001 0.001 0.001"/>
